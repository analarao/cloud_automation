# Dockerfile for Alert Pipeline
# Receives alerts from AlertManager, aggregates context, sends to LLM
# Image: chandrashekar316/capstone:alert-pipeline
# Using slim (Debian) for better MCP compatibility

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install kubectl
RUN curl -LO "https://dl.k8s.io/release/v1.29.0/bin/linux/amd64/kubectl" && \
    chmod +x kubectl && \
    mv kubectl /usr/local/bin/

# Copy and install Python dependencies
COPY requirements_alert_pipeline.txt .
RUN pip install --no-cache-dir -r requirements_alert_pipeline.txt && \
    pip cache purge

# Verify MCP installed
RUN python -c "from mcp import ClientSession; print('MCP SDK OK')"

# Copy application code
COPY alert_pipeline.py .
COPY orchestrator.py .
COPY mcp_client.py .

# Non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose webhook port
EXPOSE 9095

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9095/health || exit 1

# Run the pipeline
ENTRYPOINT ["python", "alert_pipeline.py"]
