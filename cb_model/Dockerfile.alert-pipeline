# Dockerfile for Alert Pipeline
# Receives alerts from AlertManager, aggregates context, sends to LLM
# Image: chandrashekar316/capstone:alert-pipeline
# Using slim (Debian) with Node.js for MCP server

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including Node.js
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install mcp-server-kubernetes globally (correct package name)
RUN npm install -g mcp-server-kubernetes

# Install kubectl
RUN curl -LO "https://dl.k8s.io/release/v1.29.0/bin/linux/amd64/kubectl" && \
    chmod +x kubectl && \
    mv kubectl /usr/local/bin/

# Copy and install Python dependencies
COPY requirements_alert_pipeline.txt .
RUN pip install --no-cache-dir -r requirements_alert_pipeline.txt && \
    pip cache purge

# Verify MCP installed
RUN python -c "from mcp import ClientSession; print('MCP SDK OK')"

# Copy application code
COPY alert_pipeline.py .
COPY orchestrator.py .
COPY mcp_client.py .

# Non-root user for security (but needs kubectl access)
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose webhook port
EXPOSE 9095

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9095/health || exit 1

# Run the pipeline
ENTRYPOINT ["python", "alert_pipeline.py"]
