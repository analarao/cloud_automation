# Dockerfile for Alert Pipeline
# Receives alerts from AlertManager, aggregates context, sends to LLM

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install kubectl for log fetching
RUN curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
    && chmod +x kubectl \
    && mv kubectl /usr/local/bin/

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY alert_pipeline.py .
COPY orchestrator.py .
COPY mcp_client.py .

# Expose webhook port
EXPOSE 9095

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9095/health || exit 1

# Run the pipeline
ENTRYPOINT ["python", "alert_pipeline.py"]
