  "runbooks": [
    {
      "id": "RB-001",
      "title": "High Memory Usage Remediation",
      "trigger": "memory usage > 85%",
      "steps": [
        "Check recent deployments with kubectl rollout history",
        "Analyze memory growth pattern in Prometheus",
        "If post-deployment: rollback to previous revision",
        "If gradual leak: restart pods to reclaim memory",
        "Verify recovery with kubectl get pods"
      ],
      "tags": ["memory", "oom", "leak"]
    },
    {
      "id": "RB-002",
      "title": "Pod CrashLoopBackOff Recovery",
      "trigger": "pod restart count > 3",
      "steps": [
        "Check pod events with kubectl describe",
        "Review logs for error messages",
        "If OOMKilled: increase memory limits",
        "If config error: check configmaps and secrets",
        "Apply fix and monitor for 5 minutes"
      ],
      "tags": ["crash", "restart", "oom", "config"]
    },
    {
      "id": "RB-003",
      "title": "High Latency Investigation",
      "trigger": "p99 latency > 500ms",
      "steps": [
        "Check upstream/downstream service health",
        "Query Prometheus for resource utilization",
        "Check for connection pool exhaustion",
        "If resource constrained: scale horizontally",
        "If dependency issue: check service mesh"
      ],
      "tags": ["latency", "slow", "timeout", "scale"]
    }
  ],
  "service_topology": {
