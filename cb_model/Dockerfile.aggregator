# Alert Context Aggregator - Dockerfile
# Receives alerts from AlertManager, aggregates context, and forwards to CB Model
#
# Image: chandrashekar316/capstone:alert_aggregator

FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements_aggregator.txt .
RUN pip install --no-cache-dir -r requirements_aggregator.txt && \
    pip cache purge

# Copy proto files and compile
COPY cb_model_v2.proto .
RUN python -m grpc_tools.protoc \
    -I. \
    --python_out=. \
    --grpc_python_out=. \
    cb_model_v2.proto

# Also compile the original proto for backward compatibility
COPY cb_model.proto .
RUN python -m grpc_tools.protoc \
    -I. \
    --python_out=. \
    --grpc_python_out=. \
    cb_model.proto

# Copy application code
COPY alert_context_aggregator.py .

# Webhook port
EXPOSE 9095

# Environment defaults
ENV PYTHONUNBUFFERED=1 \
    WEBHOOK_PORT=9095 \
    PROMETHEUS_URL="http://prometheus-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090" \
    ALERTMANAGER_URL="http://prometheus-kube-prometheus-alertmanager.monitoring.svc.cluster.local:9093" \
    KIALI_URL="http://kiali.istio-system.svc.cluster.local:20001" \
    LOKI_URL="http://loki.monitoring.svc.cluster.local:3100" \
    CB_MODEL_HOST="cb-model-service.monitoring.svc.cluster.local" \
    CB_MODEL_PORT="50051"

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:9095/health || exit 1

CMD ["python", "alert_context_aggregator.py"]
